# 独立项目配置模板。仅文件不存在时复制到.env.local，真实配置不要提交。
DATABASE_URL=postgresql://postgres:local_dev_password@localhost:15434/metadata_dev
POSTGRES_PASSWORD=local_dev_password
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
SYSTEM_USER_ID=6f40f555-5f1b-4d1f-807c-b209e817bfdd
DEFAULT_COMPANY_CODE=main
DEFAULT_COMPANY_NAME=默认机构
# 未配置注册表时 main 明确对应上面的原公司和原数据库，不搬迁已有数据。
# 多公司注册表只保存环境变量名称引用。下面示例请按部署环境填写独立 PG/CH 库。
# COMPANY_REGISTRY_JSON=[{"code":"main","name":"默认机构","organizationId":"6f40f555-5f1b-4d1f-807c-b209e817bfdd","databaseUrlEnv":"DATABASE_URL","clickhouse":{"hostEnv":"CLICKHOUSE_HOST","portEnv":"CLICKHOUSE_PORT","userEnv":"CLICKHOUSE_USER","passwordEnv":"CLICKHOUSE_PASSWORD","databaseEnv":"CLICKHOUSE_DATABASE"}},{"code":"acme","name":"示例公司","organizationId":"33333333-3333-4333-8333-333333333333","databaseUrlEnv":"ACME_DATABASE_URL","clickhouse":{"hostEnv":"ACME_CH_HOST","portEnv":"ACME_CH_PORT","userEnv":"ACME_CH_USER","passwordEnv":"ACME_CH_PASSWORD","databaseEnv":"ACME_CH_DATABASE"}}]
# ACME_DATABASE_URL=postgresql://eduops_acme:REPLACE_WITH_PRIVATE_PASSWORD@localhost:15434/eduops_acme
# ACME_CH_HOST=localhost
# ACME_CH_PORT=18123
# ACME_CH_USER=eduops_acme
# ACME_CH_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
# ACME_CH_DATABASE=eduops_acme
# 新公司建库专用管理员，仅部署命令使用；不传给 API、模型或浏览器。
# COMPANY_PG_ADMIN_URL=postgresql://postgres:REPLACE_WITH_PRIVATE_PASSWORD@localhost:15434/postgres
# COMPANY_CH_ADMIN_HOST=localhost
# COMPANY_CH_ADMIN_PORT=18123
# COMPANY_CH_ADMIN_USER=default
# COMPANY_CH_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
# npm.cmd run company:init -- --company acme 只初始化空库，不覆盖已有库或账号。
# 已有原公司可使用 company:secure -- --company main --configure-local 建立专用运行连接；保留原库和模型配置。
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=local_ch_password
CLICKHOUSE_DATABASE=default
# Redis可选，不配置时不使用缓存。
# REDIS_URL=redis://localhost:16379
# 对话与向量使用独立配置。只填接口前缀，不追加/chat/completions或/embeddings。
# DeepSeek示例前缀：https://api.deepseek.com；模型填账户支持工具调用的名称。
# 阿里云百炼示例前缀：https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼地址必须与密钥地域匹配；专属地址只能填写控制台实际提供的业务空间。
# 向量模型示例：text-embedding-v4。真实密钥只填.env.local，修改后重启。
CHAT_API_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=


# 独立项目配置模板。仅文件不存在时复制到.env.local，真实配置不要提交。
DATABASE_URL=postgresql://postgres:local_dev_password@localhost:15434/metadata_dev
POSTGRES_PASSWORD=local_dev_password
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
SYSTEM_USER_ID=6f40f555-5f1b-4d1f-807c-b209e817bfdd
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=local_ch_password
CLICKHOUSE_DATABASE=default
# Redis可选，不配置时不使用缓存。
# REDIS_URL=redis://localhost:16379
# 对话与向量使用独立配置。只填接口前缀，不追加/chat/completions或/embeddings。
# DeepSeek示例前缀：https://api.deepseek.com；模型填账户支持工具调用的名称。
# 阿里云百炼示例前缀：https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼地址必须与密钥地域匹配；专属地址只能填写控制台实际提供的业务空间。
# 向量模型示例：text-embedding-v4。真实密钥只填.env.local，修改后重启。
CHAT_API_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

